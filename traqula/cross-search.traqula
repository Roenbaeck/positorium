add role name;
add posit +p [{(+i1, name)}, "Polygon", '2000'],
          +p [{(+i2, name)}, "Square", '2004'],
          +p [{(+i3, name)}, "Triangle", '2003'];

/* Query variables are lexical to one search and are introduced with ?. */
search [{(?id, name), ...}, ?n, ?t]
where ?t < '2004'
return ?id, ?n, ?t;

/* A later search gets its own bindings. */
search [{(?id, name), ...}, ?n, ?t]
return ?id, ?n, ?t;
